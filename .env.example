# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Configure in AI Studio Secrets Panel)
# Public Supabase Project URL and Anon Key for client Auth, Realtime & RLS queries
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-side Supabase credentials (NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
